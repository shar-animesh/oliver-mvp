# Application
ENV=development
LOG_LEVEL=INFO
ANYIO_THREAD_POOL_TOKENS=200
OLIVER_CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://oliver_admin_reader:password@localhost:5432/oliver
# Use local only for localhost. Production must use entra.
ADMIN_AUTH_MODE=local
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_TTL_SECONDS=28800
# Format: username:pbkdf2_sha256$iterations$base64url-salt$base64url-hash
ADMIN_LOCAL_USER_HASHES=local-admin:replace-with-password-hash
ADMIN_LOCAL_ROLES=Oliver.Admin.Read,Oliver.Assessment.Test
OLIVER_API_URL=http://localhost:8001
OLIVER_INTERNAL_API_KEY=replace-with-the-same-local-key-used-by-oliver
OLIVER_REQUEST_TIMEOUT_SECONDS=960
ENTRA_TENANT_ID=replace-with-tenant-id
ENTRA_CLIENT_ID=replace-with-admin-api-app-registration-client-id
ENTRA_REQUIRED_SCOPE=access_as_user
ENTRA_ADMIN_READ_ROLES=Oliver.Admin.Read,Oliver.Platform.Admin
