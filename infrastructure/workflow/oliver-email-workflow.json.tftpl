{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "When_email_arrives_in_Oliver_mailbox": {
      "type": "ApiConnectionNotification",
      "splitOn": "@triggerBody()?['value']",
      "inputs": {
        "host": {
          "connection": {
            "name": "@parameters('$connections')['office365']['connectionId']"
          }
        },
        "method": "get",
        "path": "/v2/SharedMailbox/Mail/OnNewEmail",
        "queries": {
          "folderId": "Inbox",
          "importance": "Any",
          "includeAttachments": true,
          "mailboxAddress": "${mailbox_address}"
        }
      },
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs",
            "outputs"
          ]
        }
      }
    }
  },
  "actions": {
    "Ignore_messages_sent_by_Oliver": {
      "type": "If",
      "expression": {
        "and": [
          {
            "not": {
              "equals": [
                "@toLower(triggerBody()?['from'])",
                "${mailbox_address}"
              ]
            }
          }
        ]
      },
      "actions": {
        "Normalize_attachments": {
          "type": "Select",
          "inputs": {
            "from": "@coalesce(triggerBody()?['attachments'], json('[]'))",
            "select": {
              "attachment_id": "@coalesce(item()?['id'], item()?['name'])",
              "file_name": "@item()?['name']",
              "content_type": "@coalesce(item()?['contentType'], 'application/octet-stream')",
              "content_base64": "@item()?['contentBytes']"
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        },
        "Call_Oliver_API": {
          "type": "Http",
          "runAfter": {
            "Normalize_attachments": [
              "Succeeded"
            ]
          },
          "inputs": {
            "method": "POST",
            "uri": "${oliver_api_url}",
            "authentication": {
              "type": "ManagedServiceIdentity",
              "audience": "${oliver_api_audience}",
              "identity": "${workflow_identity_id}"
            },
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "message_id": "@coalesce(triggerBody()?['internetMessageId'], triggerBody()?['id'])",
              "conversation_id": "@coalesce(triggerBody()?['conversationId'], triggerBody()?['id'])",
              "subject": "@triggerBody()?['subject']",
              "sender_email": "@triggerBody()?['from']",
              "recipient_emails": "@string(triggerBody()?['toRecipients'])",
              "received_at": "@triggerBody()?['receivedDateTime']",
              "email_thread": "@triggerBody()?['body']",
              "attachments": "@body('Normalize_attachments')"
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        },
        "Reply_when_Oliver_requests_delivery": {
          "type": "If",
          "runAfter": {
            "Call_Oliver_API": [
              "Succeeded"
            ]
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@body('Call_Oliver_API')?['action']",
                  "SEND_EMAIL"
                ]
              }
            ]
          },
          "actions": {
            "Reply_to_original_email": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/v3/Mail/ReplyTo",
                "retryPolicy": {
                  "type": "none"
                },
                "body": {
                  "Body": "@body('Call_Oliver_API')?['email_html']",
                  "mailboxAddress": "${mailbox_address}",
                  "messageId": "@triggerBody()?['id']",
                  "ReplyAll": false,
                  "Subject": "@body('Call_Oliver_API')?['subject']"
                }
              }
            },
            "Report_delivery_sent": {
              "type": "Http",
              "runAfter": {
                "Reply_to_original_email": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "method": "POST",
                "uri": "@concat('${oliver_api_base_url}/deliveries/', body('Call_Oliver_API')?['delivery_id'], '/result')",
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "${oliver_api_audience}",
                  "identity": "${workflow_identity_id}"
                },
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "idempotency_key": "@concat(workflow()?['run']?['name'], ':', body('Call_Oliver_API')?['delivery_id'], ':sent')",
                  "outcome": "SENT",
                  "occurred_at": "@utcNow()"
                }
              }
            },
            "Report_delivery_failed": {
              "type": "Http",
              "runAfter": {
                "Reply_to_original_email": [
                  "Failed",
                  "TimedOut"
                ]
              },
              "inputs": {
                "method": "POST",
                "uri": "@concat('${oliver_api_base_url}/deliveries/', body('Call_Oliver_API')?['delivery_id'], '/result')",
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "${oliver_api_audience}",
                  "identity": "${workflow_identity_id}"
                },
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "idempotency_key": "@concat(workflow()?['run']?['name'], ':', body('Call_Oliver_API')?['delivery_id'], ':failed')",
                  "outcome": "FAILED",
                  "occurred_at": "@utcNow()",
                  "error": "@coalesce(actions('Reply_to_original_email')?['error']?['message'], 'Office 365 reply action failed')"
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      },
      "else": {
        "actions": {}
      }
    }
  },
  "outputs": {}
}
