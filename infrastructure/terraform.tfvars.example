location                            = "westeurope"
environment                         = "dev"
resource_prefix                     = "oliver"
mailbox_address                     = "oliver@example.com"
model_base_url                      = "https://your-resource-name.openai.azure.com/openai/v1/"
model_name                          = "replace-with-your-azure-openai-deployment-name"
embedding_model_name                = "replace-with-your-embedding-deployment-name"
reasoning_effort                    = "high"
oliver_image_tag                    = "latest"
admin_backend_image_tag             = "latest"
admin_frontend_image_tag            = "latest"

# Assign Entra security groups to Oliver roles. Do not place individual users in Terraform.
admin_role_group_object_ids = {
  "Oliver.Admin.Read"      = ["replace-with-admin-read-group-object-id"]
  "Oliver.Assessment.Test" = ["replace-with-assessment-operator-group-object-id"]
}

# Supply the sensitive model key through the environment instead:
# export TF_VAR_model_api_key='...'
