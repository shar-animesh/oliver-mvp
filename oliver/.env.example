LOGGING_LEVEL=INFO
OPENAI_API_KEY=replace-with-a-secret-or-key-vault-reference
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=replace-with-your-model-name
OPENAI_REASONING_EFFORT=high
OPENAI_REQUEST_TIMEOUT_SECONDS=300
OPENAI_MAX_RETRIES=0
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# llm uses the configured OPENAI_MODEL to interpret evidence; rubric is an offline fallback.
ASSESSMENT_EVALUATOR_MODE=llm
# Keep structured gate evaluation below common provider gateway limits.
ASSESSMENT_REASONING_EFFORT=medium
# One shared retry for either a transient provider status or an invalid structured contract.
ASSESSMENT_RESPONSE_RETRIES=1
ASSESSMENT_MAX_EVIDENCE_CHARS=120000
ATTACHMENT_STORAGE_DIR=.data/attachments
ATTACHMENT_STORE=filesystem
# Required only when ATTACHMENT_STORE=azure_blob. Use workload identity, never an account key.
AZURE_STORAGE_ACCOUNT_URL=https://replace-with-account.blob.core.windows.net
AZURE_STORAGE_CONTAINER=attachments
MAX_ATTACHMENT_BYTES=25000000
MAX_ATTACHMENT_UNCOMPRESSED_BYTES=100000000
MAX_EXTRACTED_ATTACHMENT_CHARS=200000
DELIVERY_VISIBILITY_TIMEOUT_SECONDS=300
INTERNAL_API_KEY=replace-with-a-long-random-logic-app-key
ADMIN_GATEWAY_API_KEY=replace-with-a-different-local-admin-gateway-key
# Local modes use the API key and local allowlists. Azure must switch both modes to entra.
ADMIN_AUTH_MODE=local
SERVICE_AUTH_MODE=local_key
# Local development only. Production authorization uses Entra app roles assigned to groups.
ADMIN_IDENTITIES=local-admin
LIFECYCLE_APPROVER_IDENTITIES=local-approver
LIFECYCLE_STAGE_SLA_DAYS=DI1:30,DI2:60,DI3:90,DI4:120
ENTRA_TENANT_ID=replace-with-tenant-id
ENTRA_API_CLIENT_ID=replace-with-oliver-api-app-registration-client-id
ENTRA_ADMIN_READ_ROLES=Oliver.Admin.Read,Oliver.Platform.Admin
ENTRA_LIFECYCLE_APPROVER_ROLES=Oliver.Lifecycle.Approve,Oliver.Platform.Admin
ENTRA_INSIGHT_OPERATOR_ROLES=Oliver.Assessment.Test,Oliver.Platform.Admin
ENTRA_SCOUT_REVIEWER_ROLES=Oliver.Scout.Review,Oliver.Platform.Admin
ENTRA_EMAIL_SERVICE_ROLES=Oliver.Service.Email
ENTRA_SCHEDULER_SERVICE_ROLES=Oliver.Service.Scheduler
ENTRA_SCOUT_SERVICE_ROLES=Oliver.Service.Scout
ENTRA_METRICS_SERVICE_ROLES=Oliver.Service.Metrics
# Explicit connector/source allowlist. Leave empty to disable Scout ingestion.
SCOUT_APPROVED_SOURCE_SYSTEMS=approved-project-register,approved-innovation-register
SCOUT_MIN_CONFIDENCE=0.7
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/oliver
